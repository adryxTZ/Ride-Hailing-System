{
  "name": "@platform-web/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for web surfaces, generated from backend/api/openapi.yaml. Never edit src/generated by hand.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "gen": "openapi-typescript \"${OPENAPI_SPEC:-../../../backend/api/openapi.yaml}\" -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5"
  }
}
