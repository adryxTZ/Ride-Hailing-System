# Copy to /opt/platform/backup.env (chmod 600). Used by the "backup" job (ops profile).
# Database to dump (the managed Postgres; a read replica is fine).
BACKUP_DATABASE_URL=postgres://<user>:<password>@<managed-host>:25060/<db>?sslmode=require
# age PUBLIC key (age1...). The private key is NOT on the server: it lives offline
# (password manager) and is only used for restores. See infra/README.md "Backups".
BACKUP_AGE_RECIPIENT=age1<public-key>
# Where dumps go: any S3-compatible store (DigitalOcean Spaces, R2, B2, MinIO).
BACKUP_BUCKET=<bucket>
BACKUP_PREFIX=platform
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=DigitalOcean
RCLONE_CONFIG_STORE_ENDPOINT=<region>.digitaloceanspaces.com
RCLONE_CONFIG_STORE_REGION=<region>
RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
# Retention: daily dumps kept this many days; Sunday dumps also copied to weekly/.
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_DAYS=90
