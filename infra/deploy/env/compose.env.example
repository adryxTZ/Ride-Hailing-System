# Copy to /opt/platform/.env on the server (one per environment). Compose variables:
# image tags, domains, sizing. No secrets here; secrets live in api.env / backup.env /
# monitoring.env (mode 600). The deploy job rewrites API_IMAGE and ADMIN_IMAGE.
COMPOSE_PROJECT_NAME=platform
DEPLOY_ENV=uat                       # uat | production
API_IMAGE=ghcr.io/<owner>/<repo>/nexa:<git-sha>
ADMIN_IMAGE=ghcr.io/<owner>/<repo>/admin:<git-sha>-uat
API_DOMAIN=uat-api.<domain>
ADMIN_DOMAIN=uat-admin.<domain>
ACME_EMAIL=ops@<domain>
API_ROLES=api,realtime,worker,scheduler
METRICS_TEXTFILE_DIR=/var/lib/platform/metrics
# Only with --profile maps (self-hosted routing/places):
MAPS_DATA_DIR=/var/lib/platform/maps
NOMINATIM_DB_PASSWORD=<random>
