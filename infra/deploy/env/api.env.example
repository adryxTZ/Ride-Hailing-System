# Copy to /opt/platform/api.env (chmod 600). Runtime configuration of the backend
# (backend/internal/kernel/config). Config fails fast on missing required values.
NEXA_BRAND=<brand-code>                  # selects backend/brands/<code>.json
NEXA_DATABASE_URL=postgres://<user>:<password>@<managed-host>:25060/<db>?sslmode=require
NEXA_LOG_LEVEL=info
NEXA_MIN_APP_VERSION=0.1.0
NEXA_FEATURES=
NEXA_CORS_ORIGINS=https://admin.<domain>
NEXA_PUBLIC_API_URL=https://api.<domain>/v1
NEXA_PUBLIC_WEB_URL=https://<domain>
NEXA_PAYMENT_WEBHOOK_BASE_URL=https://api.<domain>

# Sign-in. Production: all three empty/false. UAT may allow fixed codes for QA numbers.
NEXA_OTP_DEV_ECHO=false
NEXA_OTP_TEST_CODE=
NEXA_OTP_TEST_NUMBERS=

# Payments (Selcom checkout = pay-in; Selcom Business = payouts). "fake" only on UAT.
NEXA_PAYMENT_GATEWAY=selcom
NEXA_SELCOM_BASE_URL=
NEXA_SELCOM_API_KEY=
NEXA_SELCOM_API_SECRET=
NEXA_SELCOM_VENDOR=
NEXA_SELCOM_PAYOUT_BASE_URL=
NEXA_SELCOM_PAYOUT_API_KEY=
NEXA_SELCOM_PAYOUT_KEY_FILE=/secrets/selcom-payout.pem

# Transport regulator, per country: fake | cets | pending (pending = queued, not sent).
NEXA_REGULATOR_LATRA_ADAPTER=pending
NEXA_REGULATOR_LATRA_BASE_URL=
NEXA_REGULATOR_LATRA_JWT_ISSUER=
NEXA_REGULATOR_LATRA_JWT_AUDIENCE=cets
NEXA_REGULATOR_LATRA_JWT_KID=
NEXA_REGULATOR_LATRA_JWT_KEY_FILE=/secrets/regulator-latra.pem
NEXA_REGULATOR_LATRA_JWKS_URI=

# Push notifications (Expo push service).
NEXA_EXPO_ACCESS_TOKEN=

# Routing and places. With --profile maps these point at the containers; without,
# the backend falls back to the public demo servers (development only).
NEXA_OSRM_URL=http://osrm:5000
NEXA_NOMINATIM_URL=http://nominatim:8080
