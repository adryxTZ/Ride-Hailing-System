# Copy to /opt/platform/monitoring.env (chmod 600). Grafana Cloud stack endpoints
# (Connections > Prometheus / Loki "Send data") and an access-policy token with
# metrics:write and logs:write.
GRAFANA_PROM_URL=https://prometheus-<region>.grafana.net/api/prom/push
GRAFANA_PROM_USER=<stack-metrics-user-id>
GRAFANA_LOKI_URL=https://logs-<region>.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=<stack-logs-user-id>
GRAFANA_CLOUD_TOKEN=
# Read-only Postgres role for the River queue-depth and connection metrics.
MONITOR_DATABASE_URL=postgres://<monitor-user>:<password>@<managed-host>:25060/<db>?sslmode=require
