NEXA_BRAND=nexa
NEXA_BRANDS_DIR=./brands
NEXA_SEED_DIR=./seed
NEXA_HTTP_ADDR=:8080
NEXA_DATABASE_URL=postgres://nexa:nexa@localhost:5433/nexa?sslmode=disable
NEXA_REDIS_URL=redis://localhost:6380/0
NEXA_MIN_APP_VERSION=0.0.0
NEXA_LOG_LEVEL=debug
NEXA_FEATURES=
NEXA_OTP_TEST_CODE=0000
NEXA_OTP_TEST_NUMBERS=255626512332,255715123702
NEXA_CORS_ORIGINS=*
# Per-country regulator adapters: NEXA_REGULATOR_<NAME>_ADAPTER=fake|cets|pending (default pending: queued, not sent)
NEXA_REGULATOR_LATRA_ADAPTER=fake
